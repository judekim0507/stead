+void SteadBrainCdpBridge::ObserveBrowserMessage(std::string_view message) {
+  const bool interesting_event =
+      base::StartsWith(message, "{\"method\":\"Target.attachedToTarget\"") ||
+      base::StartsWith(message, "{\"method\":\"Target.detachedFromTarget\"") ||
+      base::StartsWith(message,
+                       "{\"method\":\"Runtime.executionContextCreated\"") ||
+      base::StartsWith(message,
+                       "{\"method\":\"Runtime.executionContextDestroyed\"") ||
+      base::StartsWith(message,
+                       "{\"method\":\"Runtime.executionContextsCleared\"");
+  const bool interesting_response =
+      base::StartsWith(message, "{\"id\":") &&
+      (!pending_runtime_results_.empty() ||
+       !pending_agent_target_creations_.empty());
+  if (!interesting_event && !interesting_response) {
+    return;
+  }
+
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(message, base::JSON_PARSE_RFC);
+  if (!parsed) {
+    return;
+  }
+  const std::string method = OptionalString(*parsed, "method");
+  const std::string outer_session = OptionalString(*parsed, "sessionId");
+  const base::DictValue* params = parsed->FindDict("params");
+  if (method == "Target.attachedToTarget" && params) {
+    const std::string* child_session = params->FindString("sessionId");
+    const base::DictValue* target_info = params->FindDict("targetInfo");
+    const std::string* target_id =
+        target_info ? target_info->FindString("targetId") : nullptr;
+    if (child_session && target_id) {
+      session_targets_[*child_session] = *target_id;
+      if (!outer_session.empty()) {
+        session_parents_[*child_session] = outer_session;
+      }
+      if (agent_owned_target_ids_.contains(*target_id)) {
+        MarkAgentOwnedTarget(*target_id, kAgentTargetResolveAttempts);
+      }
+    }
+    return;
+  }
+  if (method == "Target.detachedFromTarget" && params) {
+    const std::string* child_session = params->FindString("sessionId");
+    if (child_session) {
+      session_targets_.erase(*child_session);
+      session_parents_.erase(*child_session);
+      steadwright_contexts_.erase(*child_session);
+      main_contexts_.erase(*child_session);
+      steadwright_objects_.erase(*child_session);
+      main_objects_.erase(*child_session);
+    }
+    return;
+  }
+  if (method == "Runtime.executionContextCreated" && params) {
+    const base::DictValue* context = params->FindDict("context");
+    const std::optional<int> context_id =
+        context ? context->FindInt("id") : std::nullopt;
+    const std::string* name = context ? context->FindString("name") : nullptr;
+    const base::DictValue* auxiliary_data =
+        context ? context->FindDict("auxData") : nullptr;
+    if (context_id && name && *name == "__steadwright") {
+      steadwright_contexts_[outer_session].insert(*context_id);
+    } else if (context_id && auxiliary_data &&
+               auxiliary_data->FindBool("isDefault").value_or(false)) {
+      main_contexts_[outer_session].insert(*context_id);
+    }
+    return;
+  }
+  if (method == "Runtime.executionContextDestroyed" && params) {
+    const std::optional<int> context_id = params->FindInt("executionContextId");
+    if (context_id) {
+      steadwright_contexts_[outer_session].erase(*context_id);
+      main_contexts_[outer_session].erase(*context_id);
+    }
+    return;
+  }
+  if (method == "Runtime.executionContextsCleared") {
+    steadwright_contexts_.erase(outer_session);
+    main_contexts_.erase(outer_session);
+    steadwright_objects_.erase(outer_session);
+    main_objects_.erase(outer_session);
+    return;
+  }
+
+  const std::string key = RequestKey(*parsed);
+  if (pending_agent_target_creations_.erase(key)) {
+    const base::DictValue* result = parsed->FindDict("result");
+    const std::string* target_id =
+        result ? result->FindString("targetId") : nullptr;
+    if (target_id) {
+      agent_owned_target_ids_.insert(*target_id);
+      MarkAgentOwnedTarget(*target_id, kAgentTargetResolveAttempts);
+    }
+  }
+  const auto pending_result = pending_runtime_results_.find(key);
+  if (pending_result != pending_runtime_results_.end()) {
+    const base::DictValue* result = parsed->FindDict("result");
+    if (result) {
+      CollectObjectIds(
+          base::Value(result->Clone()),
+          pending_result->second ? &steadwright_objects_[outer_session]
+                                 : &main_objects_[outer_session]);
+    }
+    pending_runtime_results_.erase(pending_result);
+  }
+}
+
+void SteadBrainCdpBridge::RememberAllowedCommand(
+    std::string_view method,
+    const base::DictValue& message,
+    std::optional<bool> targets_steadwright_world) {
+  const std::string key = RequestKey(message);
+  if (key.empty()) {
+    return;
+  }
+  if (method == "Target.createTarget") {
+    pending_agent_target_creations_.insert(key);
+  }
+  const std::string session_id = OptionalString(message, "sessionId");
+  if (targets_steadwright_world.has_value() &&
+      (method == "Runtime.evaluate" || method == "Runtime.callFunctionOn")) {
+    pending_runtime_results_[key] = *targets_steadwright_world;
+  } else if (method == "Runtime.getProperties") {
+    const base::DictValue* params = message.FindDict("params");
+    const std::string* object_id =
+        params ? params->FindString("objectId") : nullptr;
+    if (object_id && steadwright_objects_[session_id].contains(*object_id)) {
+      pending_runtime_results_[key] = true;
+    } else if (object_id && main_objects_[session_id].contains(*object_id)) {
+      pending_runtime_results_[key] = false;
+    }
+  } else if (method == "DOM.resolveNode") {
+    const base::DictValue* params = message.FindDict("params");
+    const std::optional<int> context_id =
+        params ? params->FindInt("executionContextId") : std::nullopt;
+    if (context_id &&
+        steadwright_contexts_[session_id].contains(*context_id)) {
+      pending_runtime_results_[key] = true;
+    } else if (context_id && main_contexts_[session_id].contains(*context_id)) {
+      pending_runtime_results_[key] = false;
+    }
+  }
+  if (method == "Runtime.releaseObject") {
+    const base::DictValue* params = message.FindDict("params");
+    const std::string* object_id =
+        params ? params->FindString("objectId") : nullptr;
+    if (object_id) {
+      steadwright_objects_[session_id].erase(*object_id);
+      main_objects_[session_id].erase(*object_id);
+    }
+  } else if (method == "Runtime.releaseObjectGroup") {
+    // Object groups are not tracked separately. Clearing the session is the
+    // conservative choice: later use must prove its world again.
+    steadwright_objects_.erase(session_id);
+    main_objects_.erase(session_id);
+  }
+}
+
+std::optional<int32_t> SteadBrainCdpBridge::ResolveTabIdForTarget(
+    std::string_view target_id) const {
+  scoped_refptr<content::DevToolsAgentHost> host =
+      content::DevToolsAgentHost::GetForId(std::string(target_id));
+  content::WebContents* contents = host ? host->GetWebContents() : nullptr;
+  if (!contents) {
+    return std::nullopt;
+  }
+  contents = contents->GetOutermostWebContents();
+  if (!SameProfile(
+          Profile::FromBrowserContext(contents->GetBrowserContext()),
+          profile_)) {
+    return std::nullopt;
+  }
+  const SessionID id = sessions::SessionTabHelper::IdForTab(contents);
+  return id.is_valid() ? std::optional<int32_t>(id.id()) : std::nullopt;
+}
+
+std::optional<int32_t> SteadBrainCdpBridge::ResolveTabIdForSession(
+    std::string_view session_id) const {
+  std::string current(session_id);
+  base::flat_set<std::string> visited;
+  while (!current.empty() && visited.insert(current).second) {
+    const auto target = session_targets_.find(current);
+    if (target != session_targets_.end()) {
+      if (std::optional<int32_t> tab_id = ResolveTabIdForTarget(target->second)) {
+        return tab_id;
+      }
+    }
+    const auto parent = session_parents_.find(current);
+    if (parent == session_parents_.end()) {
+      break;
+    }
+    current = parent->second;
+  }
+  return std::nullopt;
+}
+
+bool SteadBrainCdpBridge::SessionTargetsAgentOwnedTarget(
+    std::string_view session_id) const {
+  std::string current(session_id);
+  base::flat_set<std::string> visited;
+  while (!current.empty() && visited.insert(current).second) {
+    const auto target = session_targets_.find(current);
+    if (target != session_targets_.end() &&
+        agent_owned_target_ids_.contains(target->second)) {
+      return true;
+    }
+    const auto parent = session_parents_.find(current);
+    if (parent == session_parents_.end()) {
+      break;
+    }
+    current = parent->second;
+  }
+  return false;
+}
+
+std::optional<bool> SteadBrainCdpBridge::TargetsSteadwrightWorld(
+    std::string_view method,
+    const base::DictValue& message) const {
+  if (method != "Runtime.evaluate" && method != "Runtime.callFunctionOn") {
+    return std::nullopt;
+  }
+  const std::string session_id = OptionalString(message, "sessionId");
+  const base::DictValue* params = message.FindDict("params");
+  if (!params) {
+    return std::nullopt;
+  }
+  std::optional<int> context_id = params->FindInt("contextId");
+  if (!context_id && method == "Runtime.callFunctionOn") {
+    context_id = params->FindInt("executionContextId");
+  }
+  if (context_id) {
+    const auto contexts = steadwright_contexts_.find(session_id);
+    if (contexts != steadwright_contexts_.end() &&
+        contexts->second.contains(*context_id)) {
+      return true;
+    }
+    const auto main_contexts = main_contexts_.find(session_id);
+    if (main_contexts != main_contexts_.end() &&
+        main_contexts->second.contains(*context_id)) {
+      return false;
+    }
+    return std::nullopt;
+  }
+  if (const std::string* object_id = params->FindString("objectId")) {
+    const auto objects = steadwright_objects_.find(session_id);
+    if (objects != steadwright_objects_.end() &&
+        objects->second.contains(*object_id)) {
+      return true;
+    }
+    const auto main_objects = main_objects_.find(session_id);
+    if (main_objects != main_objects_.end() &&
+        main_objects->second.contains(*object_id)) {
+      return false;
+    }
+    return std::nullopt;
+  }
+  // Runtime.evaluate without an explicit context targets the default main
+  // world. callFunctionOn must prove provenance through a context or object.
+  return method == "Runtime.evaluate" ? std::optional<bool>(false)
+                                      : std::nullopt;
+}
+
+void SteadBrainCdpBridge::MarkAgentOwnedTarget(const std::string& target_id,
+                                               int attempts_left) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (shutting_down_ || !profile_) {
+    return;
+  }
+  if (std::optional<int32_t> tab_id = ResolveTabIdForTarget(target_id)) {
+    if (SteadAgentControlService* control =
+            SteadAgentControlServiceFactory::GetForProfile(profile_)) {
+      control->MarkAgentOwnedTabForUi(*tab_id, std::string());
+    }
+    return;
+  }
+  if (attempts_left > 0) {
+    ui_task_runner_->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&SteadBrainCdpBridge::MarkAgentOwnedTarget,
+                       weak_factory_.GetWeakPtr(), target_id,
+                       attempts_left - 1),
+        base::Milliseconds(50));
+  }
+}
+
+void SteadBrainCdpBridge::QueueResult(const base::DictValue& request,
+                                      base::DictValue result) {
+  base::DictValue response;
+  const base::Value* id = request.Find("id");
+  response.Set("id", id ? id->Clone() : base::Value());
+  if (const base::Value* session_id = request.Find("sessionId")) {
+    response.Set("sessionId", session_id->Clone());
+  }
+  response.Set("result", std::move(result));
+  QueueWrite(base::WriteJson(response).value_or("{\"id\":null,\"result\":{}}"));
+}
+
+void SteadBrainCdpBridge::QueueError(const base::DictValue& request,
+                                     int code,
+                                     std::string message) {
+  base::DictValue response;
+  const base::Value* id = request.Find("id");
+  response.Set("id", id ? id->Clone() : base::Value());
+  if (const base::Value* session_id = request.Find("sessionId")) {
+    response.Set("sessionId", session_id->Clone());
+  }
+  base::DictValue error;
+  error.Set("code", code);
+  error.Set("message", std::move(message));
+  response.Set("error", std::move(error));
+  QueueWrite(base::WriteJson(response).value_or(
+      "{\"id\":null,\"error\":{\"code\":-32000,"
+      "\"message\":\"stead: policy denied command\"}}"));
+}
