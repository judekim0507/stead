+
+void SteadBrainCdpBridge::ResolveCdpConfirmation(
+    int32_t action_id,
+    SteadAgentControlService::CdpConfirmationOutcome outcome) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto parked = parked_commands_.find(action_id);
+  if (parked == parked_commands_.end()) {
+    return;
+  }
+  std::vector<std::string> messages = std::move(parked->second);
+  parked_commands_.erase(parked);
+
+  for (std::string& message : messages) {
+    std::optional<base::DictValue> parsed =
+        base::JSONReader::ReadDict(message, base::JSON_PARSE_RFC);
+    if (!parsed) {
+      continue;
+    }
+    if (outcome ==
+        SteadAgentControlService::CdpConfirmationOutcome::kApproved) {
+      const std::string* method = parsed->FindString("method");
+      if (method) {
+        RememberAllowedCommand(*method, *parsed,
+                               TargetsSteadwrightWorld(*method, *parsed));
+      }
+      if (browser_target_ && !shutting_down_) {
+        browser_target_->DispatchProtocolMessage(this,
+                                                  base::as_byte_span(message));
+      }
+      continue;
+    }
+
+    const char* error_message = "stead: denied by user";
+    if (outcome ==
+        SteadAgentControlService::CdpConfirmationOutcome::kTimedOut) {
+      error_message = "stead: confirmation timed out";
+    } else if (outcome ==
+               SteadAgentControlService::CdpConfirmationOutcome::kCancelled) {
+      error_message = "stead: cancelled";
+    }
+    QueueError(*parsed, -32000, error_message);
+  }
+}
