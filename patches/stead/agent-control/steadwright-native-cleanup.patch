+void SteadBrainCdpBridge::ParkCommand(int32_t action_id,
+                                      const base::DictValue& request,
+                                      std::string message) {
+  std::vector<std::string>& parked = parked_commands_[action_id];
+  if (parked.size() >= kMaxParkedCommandsPerScope) {
+    QueueError(request, -32000, "stead: too many pending commands");
+    return;
+  }
+  parked.push_back(std::move(message));
+}
+
+bool SteadBrainCdpBridge::HandleSteadMethod(
+    std::string_view method,
+    const base::DictValue& message) {
+  if (method == "Stead.describeTarget") {
+    const base::DictValue* params = message.FindDict("params");
+    const std::string* target_id =
+        params ? params->FindString("targetId") : nullptr;
+    const std::optional<int32_t> tab_id =
+        target_id ? ResolveTabIdForTarget(*target_id) : std::nullopt;
+    scoped_refptr<content::DevToolsAgentHost> host =
+        target_id ? content::DevToolsAgentHost::GetForId(*target_id) : nullptr;
+    content::WebContents* contents = host ? host->GetWebContents() : nullptr;
+    if (contents) {
+      contents = contents->GetOutermostWebContents();
+    }
+    content::RenderFrameHost* frame =
+        contents ? contents->GetPrimaryMainFrame() : nullptr;
+    if (!tab_id || !frame) {
+      QueueError(message, -32602, "stead: target not found");
+      return true;
+    }
+    SteadAgentControlService* control =
+        profile_ ? SteadAgentControlServiceFactory::GetForProfile(profile_)
+                 : nullptr;
+    base::DictValue result;
+    result.Set("tabId", *tab_id);
+    result.Set("frameToken", frame->GetFrameToken().ToString());
+    result.Set("agentOwned",
+               control && control->IsAgentOwnedTabForUi(*tab_id));
+    QueueResult(message, std::move(result));
+    return true;
+  }
+
+  if (method == "Stead.listTabs") {
+    base::ListValue tabs;
+    base::flat_set<int32_t> seen;
+    SteadAgentControlService* control =
+        profile_ ? SteadAgentControlServiceFactory::GetForProfile(profile_)
+                 : nullptr;
+    // BrowserList is no longer present in this Chromium checkout; the window
+    // interface iterator is its profile/tab-strip equivalent.
+    for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+      if (!browser || !SameProfile(browser->GetProfile(), profile_) ||
+          !browser->GetTabStripModel()) {
+        continue;
+      }
+      TabStripModel* tab_strip = browser->GetTabStripModel();
+      content::WebContents* active = tab_strip->GetActiveWebContents();
+      for (int index = 0; index < tab_strip->count(); ++index) {
+        content::WebContents* contents = tab_strip->GetWebContentsAt(index);
+        if (!contents) {
+          continue;
+        }
+        const SessionID id = sessions::SessionTabHelper::IdForTab(contents);
+        if (!id.is_valid() || !seen.insert(id.id()).second) {
+          continue;
+        }
+        scoped_refptr<content::DevToolsAgentHost> host =
+            content::DevToolsAgentHost::GetOrCreateForTab(contents);
+        base::DictValue tab;
+        tab.Set("tabId", id.id());
+        tab.Set("targetId", host->GetId());
+        tab.Set("url", contents->GetLastCommittedURL().spec());
+        tab.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+        tab.Set("agentOwned",
+                control && control->IsAgentOwnedTabForUi(id.id()));
+        tab.Set("active", contents == active);
+        tabs.Append(std::move(tab));
+      }
+    }
+    base::DictValue result;
+    result.Set("tabs", std::move(tabs));
+    QueueResult(message, std::move(result));
+    return true;
+  }
+
+  QueueError(message, -32601, "stead: unknown method");
+  return true;
+}
