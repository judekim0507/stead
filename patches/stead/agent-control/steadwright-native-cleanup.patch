+std::string OptionalString(const base::DictValue& dict,
+                           std::string_view key) {
+  const std::string* value = dict.FindString(key);
+  return value ? *value : std::string();
+}
+
+std::string RequestKey(const base::DictValue& message) {
+  const base::Value* id = message.Find("id");
+  if (!id) {
+    return std::string();
+  }
+  return OptionalString(message, "sessionId") + "|" +
+         base::WriteJson(id->Clone()).value_or("null");
+}
+
+bool SameProfile(Profile* lhs, Profile* rhs) {
+  return lhs && rhs &&
+         lhs->GetOriginalProfile() == rhs->GetOriginalProfile();
+}
+
+void CollectObjectIds(const base::Value& value,
+                      base::flat_set<std::string>* object_ids) {
+  if (value.is_dict()) {
+    for (const auto [key, child] : value.GetDict()) {
+      if (key == "objectId" && child.is_string()) {
+        object_ids->insert(child.GetString());
+      }
+      CollectObjectIds(child, object_ids);
+    }
+  } else if (value.is_list()) {
+    for (const base::Value& child : value.GetList()) {
+      CollectObjectIds(child, object_ids);
+    }
+  }
+}
 
