+
+  if (tab_id > 0 && IsAgentOwnedTabForUi(tab_id)) {
+    const int32_t action_id = NextActionId();
+    audit(action_id, true, "cdp_allowed",
+          "CDP command allowed on agent-owned tab.");
+    return {CdpCommandDisposition::kAllow, 0, {}};
+  }
+
+  if (tab_id > 0 && IsAnyFrameTainted(tab_id) &&
+      IsTaintSensitiveCdpMethod(method)) {
+    const int32_t action_id = NextActionId();
+    audit(action_id, false, "credential_tainted",
+          "CDP command denied: frame is credential-tainted.");
+    return {CdpCommandDisposition::kDeny, 0,
+            "frame is credential-tainted"};
   }
+
+  if (tab_id <= 0) {
+    const int32_t action_id = NextActionId();
+    audit(action_id, false, "cdp_denied",
+          "CDP session could not be resolved to a tab.");
+    return {CdpCommandDisposition::kDeny, 0, "policy denied command"};
+  }
+
+  if (permission_mode == mojom::BrainPermissionMode::kFull) {
+    const int32_t action_id = NextActionId();
+    audit(action_id, true, "cdp_allowed",
+          "CDP command allowed by full-access mode.");
+    return {CdpCommandDisposition::kAllow, 0, {}};
+  }
+
+  if (IsAllowedWithoutConfirmation(method) ||
+      ((method == "Runtime.evaluate" ||
+       method == "Runtime.callFunctionOn") &&
+       targets_steadwright_world.value_or(false))) {
+    const int32_t action_id = NextActionId();
+    audit(action_id, true, "cdp_allowed",
+          "CDP command allowed by read-only policy.");
+    return {CdpCommandDisposition::kAllow, 0, {}};
+  }
+
+  if (CdpMethodRequiresConfirmation(method, targets_steadwright_world)) {
+    if (permission_mode == mojom::BrainPermissionMode::kRead) {
+      const int32_t action_id = NextActionId();
+      audit(action_id, false, "cdp_denied",
+            "CDP command denied by read-only mode.");
+      return {CdpCommandDisposition::kDeny, 0, "read-only mode"};
+    }
+
+    const CdpCommandScope scope{tab_id, operation};
+    if (ConsumeApprovalGrant(tab_id, action_class, operation,
+                             scope.ToString())) {
+      const int32_t action_id = NextActionId();
+      audit(action_id, true, "cdp_confirmed",
+            "CDP command allowed after confirmation.");
+      return {CdpCommandDisposition::kAllow, 0, {}};
+    }
+    if (std::optional<int32_t> pending =
+            FindPendingConfirmation(tab_id, scope.ToString())) {
+      return {CdpCommandDisposition::kNeedsConfirmation, *pending, {}};
+    }
+    const int32_t action_id = NextActionId();
+    if (!session_id.empty()) {
+      action_session_ids_[action_id] = session_id;
+    }
+    RequestConfirmation(action_id, tab_id, action_class, operation,
+                        scope.ToString(),
+                        "CDP command on a user-owned tab requires confirmation.");
+    audit(action_id, false, "needs_confirmation",
+          "CDP command requires confirmation.", true);
+    return {CdpCommandDisposition::kNeedsConfirmation, action_id, {}};
+  }
+
+  const int32_t action_id = NextActionId();
+  audit(action_id, false, "cdp_denied", "CDP command denied by policy.");
+  return {CdpCommandDisposition::kDeny, 0, "policy denied command"};
