+void SteadAgentControlService::SetPendingFileSelection(
+    int32_t tab_id,
+    const std::vector<std::string>& paths,
+    SetPendingFileSelectionCallback callback) {
+  const int32_t action_id = NextActionId();
+  const mojom::ActionClass action_class = mojom::ActionClass::kNavigation;
+  const std::string operation = "SetPendingFileSelection";
+  auto finish = [&](mojom::ActionResultPtr result) {
+    RecordAudit(*result, tab_id, action_class, operation);
+    std::move(callback).Run(std::move(result));
+  };
+
+  const TabEventState event_state = browser_control_->GetTabEventState(tab_id);
+  if (!event_state.found) {
+    finish(MakeResult(action_id, false, kTabMissing, "Tab was not found.",
+                      /*stale=*/false, /*needs_snapshot=*/false,
+                      /*needs_confirmation=*/false,
+                      /*target_missing=*/true));
+    return;
+  }
+
+  std::vector<base::FilePath> file_paths;
+  file_paths.reserve(paths.size());
+  for (const std::string& path : paths) {
+    base::FilePath file_path = base::FilePath::FromUTF8Unsafe(path);
+    // Only absolute, non-traversing paths. A relative or "..'-bearing path
+    // reaching Chromium would resolve against the browser's cwd, which is not
+    // anything the agent's session scope covers.
+    if (!file_path.IsAbsolute() || file_path.ReferencesParent()) {
+      finish(MakeResult(action_id, false, kFileChooserInvalidSelection,
+                        "Upload paths must be absolute and must not traverse.",
+                        /*stale=*/false, /*needs_snapshot=*/false,
+                        /*needs_confirmation=*/false,
+                        /*target_missing=*/false));
+      return;
+    }
+    file_paths.push_back(std::move(file_path));
+  }
+
+  pending_file_selections_[tab_id] = std::move(file_paths);
+  finish(MakeResult(action_id, true, kFileChooserHandled,
+                    paths.empty()
+                        ? "Next file chooser on this tab will be cancelled."
+                        : "Next file chooser on this tab will receive the "
+                          "armed selection.",
+                    /*stale=*/false, /*needs_snapshot=*/false,
+                    /*needs_confirmation=*/false,
+                    /*target_missing=*/false));
+}
+
+void SteadAgentControlService::OnResourceLoadComplete(
+    int32_t tab_id,
+    const blink::mojom::ResourceLoadInfo& resource_load_info) {
+  if (tab_id <= 0) {
+    return;
+  }
+
+  auto record = mojom::NetworkRecord::New();
+  record->event_id = next_network_event_id_++;
+  record->tab_id = tab_id;
+  // SnapshotString is the same redaction the rest of the surface uses; the URL
+  // is the only page-controlled string that reaches the model here.
+  record->url = SnapshotString(resource_load_info.final_url.spec());
+  record->method = SnapshotString(resource_load_info.method);
+  record->resource_type = base::ToLowerASCII(network::RequestDestinationToString(
+      resource_load_info.request_destination,
+      network::EmptyRequestDestinationOption::kUseFiveCharEmptyString));
+  record->status = resource_load_info.http_status_code;
+  record->net_error = resource_load_info.net_error;
+  record->was_cached = resource_load_info.was_cached;
+  // "ok" mirrors fetch(): a transport-level success with a non-error status.
+  // A status of 0 happens for loads that never produced an HTTP response
+  // (data: URLs, cache hits without a status) and is not treated as failure
+  // when the net error is also clear.
+  record->ok = resource_load_info.net_error == net::OK &&
+               (resource_load_info.http_status_code == 0 ||
+                resource_load_info.http_status_code < 400);
+  record->timestamp_us =
+      base::TimeTicks::Now().since_origin().InMicroseconds();
+
+  std::deque<mojom::NetworkRecordPtr>& tab_log = network_log_[tab_id];
+  tab_log.push_back(std::move(record));
+  while (tab_log.size() > kMaxNetworkRecordsPerTab) {
+    tab_log.pop_front();
+  }
+}
+
+void SteadAgentControlService::GetNetworkCursor(
+    int32_t tab_id,
+    GetNetworkCursorCallback callback) {
+  const auto entry = network_log_.find(tab_id);
+  // An empty log reports the id the next record will take minus one, so a
+  // caller that registers before any traffic still sees everything that
+  // follows rather than replaying another tab's history.
+  int32_t cursor = next_network_event_id_ - 1;
+  if (entry != network_log_.end() && !entry->second.empty()) {
+    cursor = entry->second.back()->event_id;
+  }
+  std::move(callback).Run(cursor);
+}
+
+void SteadAgentControlService::GetNetworkLog(int32_t tab_id,
+                                             int32_t after_event_id,
+                                             GetNetworkLogCallback callback) {
+  std::vector<mojom::NetworkRecordPtr> records;
+  int32_t cursor = next_network_event_id_ - 1;
+  const auto entry = network_log_.find(tab_id);
+  if (entry != network_log_.end()) {
+    for (const mojom::NetworkRecordPtr& record : entry->second) {
+      cursor = std::max(cursor, record->event_id);
+      if (record->event_id > after_event_id) {
+        records.push_back(record->Clone());
+      }
+    }
+  }
+  std::move(callback).Run(std::move(records), cursor);
+}
