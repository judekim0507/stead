+#ifndef CHROME_BROWSER_UI_STEAD_BRAIN_STEAD_BRAIN_CDP_BRIDGE_H_
+#define CHROME_BROWSER_UI_STEAD_BRAIN_STEAD_BRAIN_CDP_BRIDGE_H_
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/files/scoped_file.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/sequence_checker.h"
+#include "base/values.h"
+#include "content/public/browser/devtools_agent_host_client.h"
+
+namespace base {
+class SequencedTaskRunner;
+}
+
+namespace content {
+class DevToolsAgentHost;
+}
+
+namespace stead {
+
+// Bridges ASCIIZ-framed CDP messages between the browser target and the
+// stead-brain helper. This object is created and destroyed on the UI sequence.
+class SteadBrainCdpBridge : public content::DevToolsAgentHostClient {
+ public:
+  using OutgoingFilter = base::RepeatingCallback<std::optional<std::string>(
+      std::string_view method,
+      const base::DictValue& message)>;
+
+  SteadBrainCdpBridge(base::ScopedFD read_fd,
+                      base::ScopedFD write_fd,
+                      base::OnceClosure on_disconnect);
+  SteadBrainCdpBridge(const SteadBrainCdpBridge&) = delete;
+  SteadBrainCdpBridge& operator=(const SteadBrainCdpBridge&) = delete;
+  ~SteadBrainCdpBridge() override;
+
+  void Shutdown();
+
+  // Installs the Phase 6 policy hook. A null callback allows every command.
+  void SetOutgoingFilter(OutgoingFilter filter);
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(
+      content::DevToolsAgentHost* agent_host,
+      base::span<const uint8_t> message) override;
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override;
+  bool IsTrusted() override;
+  bool MayAccessAllCookies() override;
+  bool AllowUnsafeOperations() override;
+  bool UsesBinaryProtocol() override;
+  std::string GetTypeForMetrics() override;
+
+ private:
+  // Owns the write end for the lifetime of the writer sequence, so queued
+  // writes can never touch a reused fd number after Shutdown().
+  struct Writer {
+    explicit Writer(base::ScopedFD fd);
+    ~Writer();
+    base::ScopedFD fd;
+  };
+
+  // The reader owns the read end; it closes when the loop exits on EOF or
+  // error, which happens once the helper's write end goes away.
+  static void ReadLoop(
+      base::ScopedFD read_fd,
+      scoped_refptr<base::SequencedTaskRunner> ui_task_runner,
+      base::WeakPtr<SteadBrainCdpBridge> weak_bridge);
+  static void WriteFrame(
+      Writer* writer,
+      std::string framed_message,
+      scoped_refptr<base::SequencedTaskRunner> ui_task_runner,
+      base::WeakPtr<SteadBrainCdpBridge> weak_bridge);
+
+  void HandleIncomingMessage(std::string message);
+  void QueueWrite(std::string message);
+  void OnPipeDisconnected();
+
+  scoped_refptr<content::DevToolsAgentHost> browser_target_;
+  // Deleted on the writer sequence, after every queued write.
+  std::unique_ptr<Writer, base::OnTaskRunnerDeleter> writer_;
+  base::OnceClosure on_disconnect_;
+  OutgoingFilter outgoing_filter_;
+  scoped_refptr<base::SequencedTaskRunner> ui_task_runner_;
+  scoped_refptr<base::SequencedTaskRunner> writer_task_runner_;
+  bool shutting_down_ = false;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<SteadBrainCdpBridge> weak_factory_{this};
+};
+
+}  // namespace stead
+
+#endif  // CHROME_BROWSER_UI_STEAD_BRAIN_STEAD_BRAIN_CDP_BRIDGE_H_
