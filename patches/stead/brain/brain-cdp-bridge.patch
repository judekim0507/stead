+// Copyright 2026 The Stead Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stead/brain/stead_brain_cdp_bridge.h"
+
+#include <unistd.h>
+
+#include <cstddef>
+#include <string>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "content/public/browser/devtools_agent_host.h"
+
+namespace stead {
+namespace {
+
+constexpr size_t kReadBufferBytes = 64 * 1024;
+constexpr size_t kMaxCdpFrameBytes = 256 * 1024 * 1024;
+
+}  // namespace
+
+SteadBrainCdpBridge::SteadBrainCdpBridge(
+    base::ScopedFD read_fd,
+    base::ScopedFD write_fd,
+    base::OnceClosure on_disconnect)
+    : writer_(nullptr, base::OnTaskRunnerDeleter(nullptr)),
+      on_disconnect_(std::move(on_disconnect)),
+      ui_task_runner_(base::SequencedTaskRunner::GetCurrentDefault()),
+      writer_task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(),
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN})) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(read_fd.is_valid());
+  DCHECK(write_fd.is_valid());
+  writer_ = std::unique_ptr<Writer, base::OnTaskRunnerDeleter>(
+      new Writer(std::move(write_fd)),
+      base::OnTaskRunnerDeleter(writer_task_runner_));
+
+  browser_target_ = content::DevToolsAgentHost::CreateForBrowser(
+      nullptr, content::DevToolsAgentHost::CreateServerSocketCallback());
+  if (!browser_target_->AttachClient(this)) {
+    browser_target_ = nullptr;
+    ui_task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&SteadBrainCdpBridge::OnPipeDisconnected,
+                       weak_factory_.GetWeakPtr()));
+    return;
+  }
+
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&SteadBrainCdpBridge::ReadLoop, std::move(read_fd),
+                     ui_task_runner_, weak_factory_.GetWeakPtr()));
+}
+
+SteadBrainCdpBridge::Writer::Writer(base::ScopedFD fd) : fd(std::move(fd)) {}
+
+SteadBrainCdpBridge::Writer::~Writer() = default;
+
+SteadBrainCdpBridge::~SteadBrainCdpBridge() {
+  Shutdown();
+}
+
+void SteadBrainCdpBridge::Shutdown() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (shutting_down_) {
+    return;
+  }
+  shutting_down_ = true;
+
+  weak_factory_.InvalidateWeakPtrs();
+  on_disconnect_.Reset();
+  if (browser_target_) {
+    browser_target_->DetachClient(this);
+    browser_target_ = nullptr;
+  }
+  // Hands the write end to the writer sequence for deletion after any
+  // queued frames; the reader closes its own end when it observes EOF.
+  writer_.reset();
+  writer_task_runner_.reset();
+}
+
+void SteadBrainCdpBridge::SetOutgoingFilter(OutgoingFilter filter) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  outgoing_filter_ = std::move(filter);
+}
+
+void SteadBrainCdpBridge::DispatchProtocolMessage(
+    content::DevToolsAgentHost* agent_host,
+    base::span<const uint8_t> message) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  QueueWrite(std::string(message.begin(), message.end()));
+}
+
+void SteadBrainCdpBridge::AgentHostClosed(
+    content::DevToolsAgentHost* agent_host) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (browser_target_.get() == agent_host) {
+    browser_target_ = nullptr;
+  }
+  OnPipeDisconnected();
+}
+
+bool SteadBrainCdpBridge::IsTrusted() {
+  return true;
+}
+
+bool SteadBrainCdpBridge::MayAccessAllCookies() {
+  return true;
+}
+
+bool SteadBrainCdpBridge::AllowUnsafeOperations() {
+  return true;
+}
+
+bool SteadBrainCdpBridge::UsesBinaryProtocol() {
+  return false;
+}
+
+std::string SteadBrainCdpBridge::GetTypeForMetrics() {
+  return "RemoteDebugger";
+}
+
+// static
+void SteadBrainCdpBridge::ReadLoop(
+    base::ScopedFD read_fd,
+    scoped_refptr<base::SequencedTaskRunner> ui_task_runner,
+    base::WeakPtr<SteadBrainCdpBridge> weak_bridge) {
+  std::string pending;
+  char buffer[kReadBufferBytes];
+
+  for (;;) {
+    const ssize_t bytes_read =
+        HANDLE_EINTR(read(read_fd.get(), buffer, sizeof(buffer)));
+    if (bytes_read <= 0) {
+      ui_task_runner->PostTask(
+          FROM_HERE,
+          base::BindOnce(&SteadBrainCdpBridge::OnPipeDisconnected,
+                         weak_bridge));
+      return;
+    }
+
+    const size_t previous_size = pending.size();
+    pending.append(buffer, static_cast<size_t>(bytes_read));
+
+    size_t frame_start = 0;
+    size_t search_from = previous_size;
+    for (;;) {
+      const size_t terminator = pending.find('\0', search_from);
+      if (terminator == std::string::npos) {
+        break;
+      }
+      if (terminator - frame_start > kMaxCdpFrameBytes) {
+        ui_task_runner->PostTask(
+            FROM_HERE,
+            base::BindOnce(&SteadBrainCdpBridge::OnPipeDisconnected,
+                           weak_bridge));
+        return;
+      }
+      ui_task_runner->PostTask(
+          FROM_HERE,
+          base::BindOnce(&SteadBrainCdpBridge::HandleIncomingMessage,
+                         weak_bridge,
+                         pending.substr(frame_start, terminator - frame_start)));
+      frame_start = terminator + 1;
+      search_from = frame_start;
+    }
+
+    if (frame_start != 0) {
+      pending.erase(0, frame_start);
+    }
+    if (pending.size() > kMaxCdpFrameBytes) {
+      ui_task_runner->PostTask(
+          FROM_HERE,
+          base::BindOnce(&SteadBrainCdpBridge::OnPipeDisconnected,
+                         weak_bridge));
+      return;
+    }
+  }
+}
+
+// static
+void SteadBrainCdpBridge::WriteFrame(
+    Writer* writer,
+    std::string framed_message,
+    scoped_refptr<base::SequencedTaskRunner> ui_task_runner,
+    base::WeakPtr<SteadBrainCdpBridge> weak_bridge) {
+  if (!writer->fd.is_valid() ||
+      !base::WriteFileDescriptor(writer->fd.get(), framed_message)) {
+    ui_task_runner->PostTask(
+        FROM_HERE,
+        base::BindOnce(&SteadBrainCdpBridge::OnPipeDisconnected, weak_bridge));
+  }
+}
+
+void SteadBrainCdpBridge::HandleIncomingMessage(std::string message) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!browser_target_ || shutting_down_) {
+    return;
+  }
+
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(message, base::JSON_PARSE_RFC);
+  if (parsed && !outgoing_filter_.is_null()) {
+    const std::string* method = parsed->FindString("method");
+    if (method) {
+      std::optional<std::string> reason = outgoing_filter_.Run(*method, *parsed);
+      if (reason) {
+        base::DictValue response;
+        const base::Value* id = parsed->Find("id");
+        response.Set("id", id ? id->Clone() : base::Value());
+        if (const base::Value* session_id = parsed->Find("sessionId")) {
+          response.Set("sessionId", session_id->Clone());
+        }
+        base::DictValue error;
+        error.Set("code", -32000);
+        error.Set("message", "stead: " + *reason);
+        response.Set("error", std::move(error));
+        QueueWrite(base::WriteJson(response).value_or(
+            "{\"id\":null,\"error\":{\"code\":-32000,"
+            "\"message\":\"stead: policy denied command\"}}"));
+        return;
+      }
+    }
+  }
+
+  browser_target_->DispatchProtocolMessage(this, base::as_byte_span(message));
+}
+
+void SteadBrainCdpBridge::QueueWrite(std::string message) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (shutting_down_ || !writer_ || !writer_task_runner_) {
+    return;
+  }
+  message.push_back('\0');
+  // Unretained is safe: writer_ is deleted on this same sequence, after every
+  // task posted before Shutdown().
+  writer_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&SteadBrainCdpBridge::WriteFrame,
+                     base::Unretained(writer_.get()), std::move(message),
+                     ui_task_runner_, weak_factory_.GetWeakPtr()));
+}
+
+void SteadBrainCdpBridge::OnPipeDisconnected() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (shutting_down_ || on_disconnect_.is_null()) {
+    return;
+  }
+  std::move(on_disconnect_).Run();
+}
+
+}  // namespace stead
