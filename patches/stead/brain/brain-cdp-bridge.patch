+void SteadBrainService::OnCdpBridgeDisconnected() {
+  LOG(WARNING) << "stead-brain CDP pipe disconnected";
+  // The bridge invokes this from its own method; destroy it from a fresh
+  // task rather than underneath its own stack frame.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<SteadBrainService> service) {
+                       if (service) {
+                         service->cdp_bridge_.reset();
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
